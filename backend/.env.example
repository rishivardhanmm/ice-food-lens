# OpenAI (or an OpenAI-compatible endpoint, e.g. Azure AI Foundry)
OPENAI_API_KEY=sk-your-key-here
# Leave OPENAI_BASE_URL empty to use public OpenAI. For Azure AI Foundry, set it to
# https://<your-resource>.services.ai.azure.com/openai/v1
OPENAI_BASE_URL=
OPENAI_VISION_MODEL=gpt-4o-mini

# Database (SQLite by default for MVP; swap for Postgres URL in prod)
DATABASE_URL=sqlite:///./storage/foodlens.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/foodlens

# Storage
UPLOAD_DIR=./storage/uploads
EXPORT_DIR=./storage/exports

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
